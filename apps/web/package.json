{
  "name": "@maze/web",
  "version": "0.1.0",
  "private": true,
  "description": "Maze Lab web app (Vite + React 19); also the UI for the Tauri desktop/mobile shells",
  "type": "module",
  "scripts": {
    "dev": "vite --port 41920 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 41921 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "postbuild": "node scripts/check-bundle-size.mjs",
    "e2e": "playwright test",
    "check:viewports": "node scripts/viewport-check.mjs",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@maze/core": "workspace:*",
    "@maze/player": "workspace:*",
    "@maze/renderer": "workspace:*",
    "@maze/ui": "workspace:*",
    "@tanstack/react-router": "^1.170.40",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1"
  }
}
