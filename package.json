{
  "name": "maze-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Maze Lab monorepo: maze generation, solving, visualisation and learning tools",
  "packageManager": "pnpm@10.18.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@maze/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
