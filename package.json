{
  "name": "maze-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Maze Lab monorepo: maze generation, solving, visualisation and learning tools",
  "packageManager": "pnpm@10.18.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@maze/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "lint:fix": "eslint . --fix",
    "e2e": "pnpm --filter @maze/web e2e",
    "knip": "knip",
    "prepare": "lefthook install || exit 0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2"
  }
}
