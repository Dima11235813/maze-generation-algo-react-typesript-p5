# dependencies
node_modules/
.pnpm-store/

# build outputs
dist/
# Anchored: a bare `build/` also matched apps/web/src/routes/build (the Build editor source).
/build/
apps/*/build/
packages/*/build/
coverage/
.turbo/
*.tsbuildinfo

# environment (never commit secrets; see proj-mgmt/07-security.md)
.env
.env.*
!.env.example

# logs and OS files
.local/
*.log
.DS_Store
Thumbs.db

# editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# test artefacts
playwright-report/
test-results/

# apps/legacy has its own .gitignore (frozen CRA app)

# agent worktrees (git worktree add targets)
.claude/worktrees/
.claude/settings.local.json
